{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_DIR}}/hooks/block-destructive-bash.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Read|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_DIR}}/hooks/block-secret-reads.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_DIR}}/hooks/block-em-dashes.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_DIR}}/hooks/flag-god-files.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_DIR}}/hooks/prune-merged-worktrees.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
