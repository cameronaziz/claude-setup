{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git",
      "git-credential-osxkeychain",
      "git-remote-https",
      "ssh",
      "ssh-add",
      "ssh-agent"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "dev.azure.com",
        "ssh.dev.azure.com",
        "login.microsoftonline.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/engineering",
        "~/.azure"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.aws/config",
        "~/.ssh",
        "~/.npmrc",
        "~/.netrc",
        "~/.config/gh/hosts.yml",
        "~/.docker/config.json",
        "~/.kube/config",
        "~/.gnupg",
        "~/Library/Keychains"
      ]
    }
  }
}
